# Application
ATLAS_APP_URL=https://preview.example.com
NODE_ENV=production

# Demo identities are limited to protected Vercel previews or explicit local development/tests.
# This flag has no effect in a production runtime.
ATLAS_TEST_MODE=false

# Initial launch scope. Public launch remains adults / France until dedicated reviews exist.
ATLAS_PUBLIC_COUNTRY=FR
ATLAS_LAUNCH_AUDIENCES=adult
ATLAS_PUBLIC_LAUNCH_APPROVED=false

# Public legal identity. These values are rendered only on the public legal pages.
ATLAS_LEGAL_ENTITY=
ATLAS_LEGAL_FORM=
ATLAS_LEGAL_ADDRESS=
ATLAS_REGISTRATION_ID=
ATLAS_SHARE_CAPITAL=
ATLAS_PUBLICATION_DIRECTOR=
ATLAS_VAT_ID=
ATLAS_SUPPORT_EMAIL=
ATLAS_PRIVACY_EMAIL=
ATLAS_SECURITY_EMAIL=
ATLAS_HUMAN_RELAY=
ATLAS_HOST_LEGAL_NAME=
ATLAS_HOST_LEGAL_ADDRESS=
ATLAS_HOST_CONTACT=
ATLAS_TERMS_VERSION=
ATLAS_PRIVACY_VERSION=

# Signed conversation continuity — required for multi-turn continuity.
# Generate at least 32 random characters and keep this server-side only.
ATLAS_CONVERSATION_STATE_SECRET=replace-with-a-long-random-secret

# Protected laboratory diagnostics
ATLAS_LAB_ENABLED=false

# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/atlas?sslmode=require

# Initial administrator — remove after bootstrap
ATLAS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ATLAS_BOOTSTRAP_ADMIN_NAME=ATLAS Administrator
ATLAS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-one-time-secret

# OpenAI cognitive gateway — always consent and policy gated
OPENAI_API_KEY=
# economy | balanced | maximum
ATLAS_OPENAI_POWER_MODE=balanced
# Fast lane for simple turns
ATLAS_OPENAI_FAST_MODEL=gpt-5-mini
# Main high-quality conversational/reasoning lane
ATLAS_OPENAI_BALANCED_MODEL=gpt-5.1
# Deep lane. Enable only when the organization has access and accepts the cost profile.
ATLAS_OPENAI_DEEP_MODEL=gpt-5-pro
# Legacy compatibility alias; balanced model takes precedence when set above.
ATLAS_OPENAI_MODEL=gpt-5.1

# Transactional email — Brevo is preferred; Resend remains a supported fallback.
BREVO_API_KEY=
RESEND_API_KEY=
ATLAS_EMAIL_FROM=ATLAS <security@example.com>
# Keep true while validating Brevo without delivering messages.
ATLAS_EMAIL_SANDBOX=true

# Scheduled maintenance
CRON_SECRET=replace-with-a-random-secret

# Sandbox payments
ATLAS_PAYMENT_ENV=sandbox
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
ATLAS_STRIPE_PRICE_INDIVIDUAL=price_replace
ATLAS_STRIPE_PRICE_PROFESSIONAL=price_replace
ATLAS_STRIPE_PRICE_ORGANIZATION=price_replace
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
ATLAS_PAYPAL_AMOUNT_INDIVIDUAL=9.00
ATLAS_PAYPAL_AMOUNT_PROFESSIONAL=39.00
ATLAS_PAYPAL_AMOUNT_ORGANIZATION=99.00

# Production checkout remains blocked without these values and explicit enablement.
ATLAS_ENABLE_PRODUCTION_CHECKOUT=false

# Evidence-based release gates. Set to true only after the named proof exists.
ATLAS_OBSERVABILITY_READY=false
ATLAS_INCIDENT_ALERTING_READY=false
ATLAS_ROLLBACK_READY=false
ATLAS_LEGAL_REVIEW_APPROVED=false
ATLAS_PRIVACY_REVIEW_APPROVED=false
ATLAS_SECURITY_REVIEW_APPROVED=false
ATLAS_CLINICAL_REVIEW_APPROVED=false
ATLAS_MINOR_SAFETY_REVIEW_APPROVED=false
ATLAS_SENIOR_REVIEW_APPROVED=false
ATLAS_AUTONOMOUS_EMOTIONAL_CORE_READY=false
ATLAS_GOVERNED_DECISION_ENGINE_READY=false
ATLAS_AUTOMATIC_EXTERNAL_ACTIONS_DISABLED=true
ATLAS_EMERGENCY_RESOURCES_VALIDATED=false
ATLAS_ACCESSIBILITY_REVIEW_APPROVED=false
ATLAS_LOAD_TESTING_PASSED=false
ATLAS_CONVERSATION_EVALUATION_PASSED=false
ATLAS_DATA_RETENTION_CONFIGURED=false
ATLAS_DELETION_WORKFLOW_READY=false

# Optional analytics identifiers — activation also requires user consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
