# Application
ATLAS_APP_URL=https://preview.example.com
NODE_ENV=production

# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/atlas?sslmode=require

# Initial administrator — remove after bootstrap
ATLAS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ATLAS_BOOTSTRAP_ADMIN_NAME=ATLAS Administrator
ATLAS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-one-time-secret

# External AI — optional and consent gated
# Modes: openai | gemini | anthropic | mistral | xai | deepseek | cohere | qwen | collaboration | ensemble
ATLAS_AI_MODE=openai
# Comma-separated allowlist used by ensemble mode.
ATLAS_AI_PROVIDERS=openai,gemini,anthropic,mistral,xai,deepseek,cohere,qwen
# Provider used to synthesize successful ensemble candidates into the final ATLAS reply.
ATLAS_SYNTHESIZER_PROVIDER=openai

OPENAI_API_KEY=
ATLAS_OPENAI_MODEL=gpt-5

GEMINI_API_KEY=
ATLAS_GEMINI_MODEL=gemini-3.6-flash

ANTHROPIC_API_KEY=
ATLAS_ANTHROPIC_MODEL=

MISTRAL_API_KEY=
ATLAS_MISTRAL_MODEL=
ATLAS_MISTRAL_BASE_URL=https://api.mistral.ai/v1

XAI_API_KEY=
ATLAS_XAI_MODEL=
ATLAS_XAI_BASE_URL=https://api.x.ai/v1

DEEPSEEK_API_KEY=
ATLAS_DEEPSEEK_MODEL=deepseek-chat
ATLAS_DEEPSEEK_BASE_URL=https://api.deepseek.com

COHERE_API_KEY=
ATLAS_COHERE_MODEL=

QWEN_API_KEY=
ATLAS_QWEN_MODEL=
# Set the official Model Studio compatible-mode endpoint for your chosen region/account.
ATLAS_QWEN_BASE_URL=

# Connected services — OAuth credentials stay server-side only.
# Callback pattern: ${ATLAS_APP_URL}/api/connections/<provider>/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Gmail + Calendar + Drive + basic identity. Request additional scopes incrementally.
ATLAS_GOOGLE_SCOPES=openid,email,profile,https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/calendar.readonly,https://www.googleapis.com/auth/drive.metadata.readonly

SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
ATLAS_SLACK_SCOPES=channels:read,groups:read,im:read,mpim:read,search:read,users:read

# Prefer a GitHub App for fine-grained repository permissions and short-lived tokens.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
ATLAS_GITHUB_SCOPES=read:user,user:email

LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=
ATLAS_LINEAR_SCOPES=read

# Key-encryption/wrapping key for encrypted connector secrets if an external secret manager is not used.
# Never commit a real value. Production should prefer a managed secret store.
ATLAS_CONNECTOR_KEY_ENCRYPTION_KEY=

# Transactional email — optional until account recovery/invitations are enabled
RESEND_API_KEY=
ATLAS_EMAIL_FROM=ATLAS <security@example.com>

# Scheduled maintenance
CRON_SECRET=replace-with-a-random-secret

# Sandbox payments
ATLAS_PAYMENT_ENV=sandbox
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
ATLAS_STRIPE_PRICE_INDIVIDUAL=price_replace
ATLAS_STRIPE_PRICE_PROFESSIONAL=price_replace
ATLAS_STRIPE_PRICE_ORGANIZATION=price_replace
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
ATLAS_PAYPAL_AMOUNT_INDIVIDUAL=9.00
ATLAS_PAYPAL_AMOUNT_PROFESSIONAL=39.00
ATLAS_PAYPAL_AMOUNT_ORGANIZATION=99.00

# Production checkout remains blocked without these values and explicit enablement
ATLAS_LEGAL_ENTITY=
ATLAS_TERMS_VERSION=
ATLAS_PRIVACY_VERSION=
ATLAS_ENABLE_PRODUCTION_CHECKOUT=false

# Optional analytics identifiers — activation also requires user consent
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
