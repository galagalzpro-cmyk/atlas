{
  "name": "atlas",
  "version": "1.0.0-rc.1",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:runtime": "node --experimental-strip-types tests/atlas-runtime.test.ts",
    "test:core": "node --experimental-strip-types tests/atlas-core-conversation.test.ts",
    "test:v4": "node --experimental-strip-types tests/atlas-v4-autonomy.test.ts",
    "check:architecture": "node scripts/validate-architecture.mjs",
    "check:security": "node scripts/validate-server-security.mjs",
    "db:migrate": "node --experimental-strip-types scripts/migrate-database.ts",
    "db:bootstrap-admin": "node --experimental-strip-types scripts/bootstrap-admin.ts",
    "check": "npm run check:architecture && npm run check:security && npm run test:runtime && npm run test:core && npm run test:v4 && npm run typecheck && npm run build"
  },
  "dependencies": {
    "next": "16.2.12",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "7.0.2"
  }
}
